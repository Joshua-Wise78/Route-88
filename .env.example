# Route-88 Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgres://user:password@localhost:5432/route88

# Postgres container variables (used by docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=route88
POSTGRES_PORT=5432

# ==========================================
# Application Configuration
# ==========================================
PORT=3333
DEFAULT_REGION=sw-ohio
ENABLE_SCHEDULER=true

# ==========================================
# API Keys
# ==========================================
# OHGO API key from the Ohio Department of Transportation (required)
OHGO_API_KEY=your-ohgo-api-key-here

# Internal API key used to protect backend endpoints (bearer token)
INTERNAL_API_KEY=your-secure-internal-api-key

# ==========================================
# External Geocoding & Routing Services
# ==========================================
# OSRM backend endpoint for turn-by-turn routing
OSRM_URL=http://osrm:5000

# Nominatim backend endpoint for address geocoding & autocomplete
NOMINATIM_URL=http://nominatim:8080

# ==========================================
# Discord Webhooks (Optional)
# Leave empty or omit if Discord integration is not needed.
# ==========================================
DISCORD_INCIDENTS_WEBHOOK_URL=
DISCORD_CONSTRUCTION_WEBHOOK_URL=
DISCORD_SLOWDOWNS_WEBHOOK_URL=
DISCORD_DAILY_WEBHOOK_URL=
