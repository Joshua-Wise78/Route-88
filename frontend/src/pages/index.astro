---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Ohio Real-Time Traffic Dashboard">
  <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Active Incidents</h1>
    <button id="refresh-btn" class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 focus:outline-none">
      Refresh Data
    </button>
  </header>

  <div id="error-message" class="hidden bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg shadow-sm">
    <div class="flex items-center">
      <div class="ml-3">
        <p class="text-sm text-red-700 font-medium" id="error-text">Unable to connect to the traffic server. Please try again later.</p>
      </div>
    </div>
  </div>

  <div id="loading" class="flex flex-col items-center justify-center py-20">
    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-slate-900 mb-4"></div>
    <span class="text-slate-600 font-medium">Fetching live traffic data...</span>
  </div>

  <div id="incidents-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Cards will inject here -->
  </div>
</MainLayout>

<script>
  const API_URL = 'http://100.102.78.73:8081/api/v1/traffic/incidents?region=dayton';

  const grid = document.getElementById('incidents-grid');
  const loading = document.getElementById('loading');
  const errorMsg = document.getElementById('error-message');
  const refreshBtn = document.getElementById('refresh-btn');

  async function fetchIncidents() {
    try {
      loading.classList.remove('hidden');
      grid.innerHTML = '';
      errorMsg.classList.add('hidden');
      const response = await fetch(API_URL);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      
      const data = await response.json();
      renderIncidents(data.data || []);
    } catch (error) {
      console.error("Failed to fetch incidents:", error);
      errorMsg.classList.remove('hidden');
    }  finally {
      loading.classList.add('hidden');
    }
  }

  function renderIncidents(incidents) {
    if (incidents.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full bg-slate-100 rounded-lg p-8 text-center border border-dashed border-slate-300">
          <p class="text-slate-500 font-medium">No active incidents reported at this time.</p>
        </div>
      `;
      return;
    }

    const html = incidents.map(inc => {
      const isClosed = inc.roadStatus === 'CLOSED';
      const borderClass = isClosed ? 'border-red-500' : 'border-amber-500';
      const badgeBg = isClosed ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800';

      return `
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 border-l-4 ${borderClass} overflow-hidden flex flex-col hover:shadow-md transition-shadow">
          <div class="p-5 border-b border-slate-100 flex justify-between items-start gap-4">
            <h3 class="font-bold text-slate-800 leading-tight">${inc.routeName}</h3>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold whitespace-nowrap ${badgeBg}">
              ${inc.roadStatus}
            </span>
          </div>
          <div class="p-5 flex-grow flex flex-col gap-2">
            <div class="flex items-start text-sm">
              <span class="font-semibold text-slate-700 min-w-[70px]">Location:</span>
              <span class="text-slate-600">${inc.location}</span>
            </div>
            <div class="flex items-start text-sm">
              <span class="font-semibold text-slate-700 min-w-[70px]">Direction:</span>
              <span class="text-slate-600">${inc.direction}</span>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100">
              <p class="text-sm text-slate-600 leading-relaxed">${inc.description}</p>
            </div>
          </div>
        </div>
      `;
    }).join('');

    grid.innerHTML = html;
  }

  refreshBtn.addEventListener('click', fetchIncidents);
  fetchIncidents();
</script>
